# Publieke basis-URL. Vercel gebruikt zonder deze waarde automatisch zijn systeem-URL.
# Stel dit bij productie in op het definitieve domein: https://lijstjesenlootjes.nl (zonder www).
NEXT_PUBLIC_SITE_URL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# One-off transactional mail via Resend (optional; without both values no mail is sent).
# Use a send-only API key dedicated to this project and a sender on a verified domain,
# for example: Lijstjes & Lootjes <noreply@lijstjesenlootjes.nl>
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Fallback reply address for unknown hosts (previews, localhost). Known domains reply to their own contact address.
EMAIL_REPLY_TO=
# Optional sender per public domain; falls back to EMAIL_FROM. The domain must be verified in Resend.
# Example: Wishlists & Draws <noreply@wishanddraw.com>
EMAIL_FROM_WISHANDDRAW_COM=
# Testing only: send provider calls to a stand-in instead of Resend. Leave empty in production.
EMAIL_API_URL=

# Optional dedicated secret for the keyed hash used by opt-in link recovery. Without it SUPABASE_SECRET_KEY is used;
# rotating that key then makes existing recovery hashes unmatchable. At least 32 characters when set.
RECOVERY_HASH_SECRET=

# Protects /admin. Use a password of at least 12 characters and a random
# session secret of at least 32 characters (for example: openssl rand -base64 32).
THEME_ADMIN_PASSWORD=
THEME_ADMIN_SESSION_SECRET=

# Amazon Associates (optional). The amazon.com programme for wishanddraw.com ships with its
# tag in code; override per environment, or set AMAZON_AFFILIATE_DISABLED=1 as a kill switch.
AMAZON_ASSOCIATE_TAG_US=
AMAZON_AFFILIATE_DISABLED=

# bol Affiliate Programme (optional). The Dutch programme for lijstjesenlootjes.nl ships with
# its public site code in code; override per environment, or set BOL_AFFILIATE_DISABLED=1 as a
# kill switch. Never put Marketing Catalog API client credentials in code or in git.
BOL_AFFILIATE_SITE_ID=
BOL_AFFILIATE_DISABLED=

# Authorizes the daily retention cleanup (Vercel Cron sends it as a Bearer token).
# At least 32 characters, for example: openssl rand -base64 32
CRON_SECRET=

# Seals the organizer's address for the one-off draw reminder (AES-256-GCM). Exactly 32 random bytes, base64:
#   openssl rand -base64 32
# Without it the reminder option is hidden. Rotating it makes sealed addresses unreadable; pending reminders are then dropped.
REMINDER_ENCRYPTION_KEY=

# Resend webhook signing secret (whsec_...), from Resend > Webhooks. Endpoint: https://lijstjesenlootjes.nl/api/webhooks/resend
# with the events email.delivered, email.bounced, email.complained and email.delivery_delayed. Without it the endpoint answers 503.
RESEND_WEBHOOK_SECRET=

# Optional: how long (ms) a server instance keeps the theme settings before reading them again. 0 disables the cache.
THEME_SETTINGS_CACHE_TTL_MS=
