# Publieke basis-URL. Vercel gebruikt zonder deze waarde automatisch zijn systeem-URL.
# Stel dit bij productie in op het definitieve domein: https://lijstjesenlootjes.nl (zonder www).
NEXT_PUBLIC_SITE_URL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Protects /admin. Use a password of at least 12 characters and a random
# session secret of at least 32 characters (for example: openssl rand -base64 32).
THEME_ADMIN_PASSWORD=
THEME_ADMIN_SESSION_SECRET=

# Amazon Associates (optional). The amazon.com programme for wishanddraw.com ships with its
# tag in code; override per environment, or set AMAZON_AFFILIATE_DISABLED=1 as a kill switch.
AMAZON_ASSOCIATE_TAG_US=
AMAZON_AFFILIATE_DISABLED=

# Authorizes the daily retention cleanup (Vercel Cron sends it as a Bearer token).
# At least 32 characters, for example: openssl rand -base64 32
CRON_SECRET=
